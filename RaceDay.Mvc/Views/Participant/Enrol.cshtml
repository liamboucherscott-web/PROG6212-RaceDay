@model RaceDay.Mvc.Models.ParticipantEnrolmentViewModel

@{
    ViewData["Title"] = "Enrol in Event";
}

<h1>Enrol in @Model.EventName</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Enrol">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <input type="hidden" asp-for="EventId" />

            <div class="form-group">
                <label class="control-label">Event</label>
                <input type="text" class="form-control" value="@Model.EventName" disabled />
            </div>

            <div class="form-group mt-3">
                <label asp-for="CategoryId" class="control-label">Select Category</label>
               
                <input asp-for="CategoryId" class="form-control" type="number" placeholder="Enter Category ID (e.g., 1)" />
                <span asp-validation-for="CategoryId" class="text-danger"></span>
                <small class="text-muted">Please enter the ID of the category you wish to join.</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Confirm Enrolment" class="btn btn-success w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="BrowseEvents" class="btn btn-secondary">Back to Events</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}