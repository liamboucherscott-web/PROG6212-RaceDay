@model List<RaceDay.Mvc.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<h1>Event Enrolments</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Participant</th>
            <th>Event</th>
            <th>Category</th>
            <th>Enrolment Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ParticipantName</td>
                    <td>@item.EventName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.Status == "Confirmed")
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No enrolments found.</td>
            </tr>
        }
    </tbody>
</table>