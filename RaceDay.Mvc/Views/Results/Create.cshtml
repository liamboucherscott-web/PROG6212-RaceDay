@model RaceDay.Mvc.Models.ResultViewModel

@{
    ViewData["Title"] = "Capture Result";
}

<h1>Capture Result</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="EnrolmentId" />

            <div class="form-group">
                <label asp-for="FinishTime" class="control-label">Finish Time</label>
                <input asp-for="FinishTime" class="form-control" placeholder="e.g., 01:30:00 (HH:MM:SS)" />
                <span asp-validation-for="FinishTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FinishingPosition" class="control-label">Finishing Position</label>
                <input asp-for="FinishingPosition" class="form-control" type="number" />
                <span asp-validation-for="FinishingPosition" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save Result" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
