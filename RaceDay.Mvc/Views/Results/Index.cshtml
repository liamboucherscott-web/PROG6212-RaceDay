@model List<RaceDay.Mvc.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Capture Results";
}

<h1>Capture Results</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Participant</th>
            <th>Category</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ParticipantName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Create" asp-route-enrolmentId="@item.EnrolmentId" class="btn btn-sm btn-primary">Capture Result</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No participants found for this event.</td>
            </tr>
        }
    </tbody>
</table>