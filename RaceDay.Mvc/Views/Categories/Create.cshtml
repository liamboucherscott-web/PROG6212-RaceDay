@model RaceDay.Mvc.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<h1>Add Category to Event</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="EventId" class="control-label">Event ID</label>
                <input asp-for="EventId" class="form-control" type="number" />
                <span asp-validation-for="EventId" class="text-danger"></span>
                <small class="text-muted">Enter the ID of the event you want to add this category to.</small>
            </div>

            <div class="form-group">
                <label asp-for="Name" class="control-label">Category Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., 5km Fun Run, Under 18" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaxParticipants" class="control-label">Max Participants</label>
                <input asp-for="MaxParticipants" class="form-control" type="number" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EntryFee" class="control-label">Entry Fee (R)</label>
                <input asp-for="EntryFee" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Add Category" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="Events">Back to Events</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}