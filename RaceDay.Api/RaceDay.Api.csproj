<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);NU1902;NU1903;1591</NoWarn>
		<UserSecretsId>0313cf89-4be9-4116-b6ba-660568559686</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
	</ItemGroup>

</Project>